<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transaction-summary"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="transaction-summary-report">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String"/>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>
    <parameter name="transactionType" class="java.lang.String"/>

    <!-- Fields -->
    <field name="transactionDate" class="java.lang.String"/>
    <field name="itemCode" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="transactionType" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unitCost" class="java.math.BigDecimal"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <field name="createdBy" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="totalTransactions" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{itemCode}]]></variableExpression>
    </variable>
    <variable name="grandTotalAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAmount}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="95">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Transaction Summary Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="60" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="55" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="55" y="0" width="95" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Item]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="50" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="45" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty ]]></text>
            </staticText>
            <staticText>
                <reportElement x="245" y="0" width="60" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Cost ]]></text>
            </staticText>
            <staticText>
                <reportElement x="305" y="0" width="60" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price ]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="0" width="65" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Total ]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="55" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="485" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ User]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="15">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="55" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionDate}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="0" width="95" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="150" y="0" width="50" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionType}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="200" y="0" width="45" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="245" y="0" width="60" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unitCost}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="305" y="0" width="60" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="365" y="0" width="65" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="430" y="0" width="55" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="485" y="0" width="70" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdBy}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="45">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="300" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Transactions: " + $V{totalTransactions}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="0" y="25" width="300" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Grand Total Amount: " + $P{currencySymbol} + " " + new java.text.DecimalFormat("#,##0.00").format($V{grandTotalAmount})]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
