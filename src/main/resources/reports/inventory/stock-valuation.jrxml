<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="stock-valuation"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="stock-valuation-report">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String"/>
    <parameter name="categoryId" class="java.lang.Long"/>

    <!-- Fields -->
    <field name="itemCode" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="categoryName" class="java.lang.String"/>
    <field name="unit" class="java.lang.String"/>
    <field name="quantityOnHand" class="java.math.BigDecimal"/>
    <field name="costPrice" class="java.math.BigDecimal"/>
    <field name="totalValue" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="grandTotalValue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalValue}]]></variableExpression>
    </variable>
    <variable name="totalItems" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{itemCode}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="80">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock Valuation Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="60" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Item Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="0" width="120" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Item Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="90" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="50" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Unit]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="65" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty ]]></text>
            </staticText>
            <staticText>
                <reportElement x="395" y="0" width="75" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Cost Price ]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="85" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Value ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="15">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="70" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemCode}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="70" y="0" width="120" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="190" y="0" width="90" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{categoryName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="50" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unit}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="330" y="0" width="65" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantityOnHand}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="395" y="0" width="75" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{costPrice}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="470" y="0" width="85" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalValue}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="45">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="300" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Items: " + $V{totalItems}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="25" width="555" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Grand Total Valuation: " + $P{currencySymbol} + " " + new java.text.DecimalFormat("#,##0.00").format($V{grandTotalValue})]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
