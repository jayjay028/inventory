<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="voided-transactions"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              columnWidth="555"
              uuid="f6a7b8c9-d0e1-2345-fabc-456789012345">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>

    <!-- Fields -->
    <field name="saleNo" class="java.lang.String"/>
    <field name="saleDate" class="java.lang.String"/>
    <field name="customerName" class="java.lang.String"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="voidReason" class="java.lang.String"/>
    <field name="voidedBy" class="java.lang.String"/>
    <field name="voidedAt" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="totalVoidedCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{saleNo}]]></variableExpression>
    </variable>
    <variable name="totalVoidedAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAmount}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Voided Transactions Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="85" width="555" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#C00000"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="55" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Sale #]]></text>
            </staticText>
            <staticText>
                <reportElement x="55" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Sale Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="125" y="0" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer]]></text>
            </staticText>
            <staticText>
                <reportElement x="205" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="110" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Reason]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Voided By]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="0" width="90" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Void Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="55" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $F{saleNo}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="0" width="70" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{saleDate}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="125" y="0" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{customerName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="205" y="0" width="70" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="275" y="0" width="110" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $F{voidReason}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="385" y="0" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{voidedBy}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="465" y="0" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{voidedAt}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="45">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="150" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ Total Voided Transactions:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="5" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalVoidedCount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="25" width="150" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ Total Voided Amount:]]></text>
            </staticText>
            <textField pattern="₱ #,##0.00">
                <reportElement x="150" y="25" width="130" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalVoidedAmount}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
