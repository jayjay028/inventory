<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="vat-summary"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="e5f6a7b8-c9d0-1234-ef01-345678901234">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>

    <!-- Fields -->
    <field name="description" class="java.lang.String"/>
    <field name="vatableSales" class="java.math.BigDecimal"/>
    <field name="vatAmount" class="java.math.BigDecimal"/>
    <field name="vatExemptSales" class="java.math.BigDecimal"/>
    <field name="zeroRatedSales" class="java.math.BigDecimal"/>
    <field name="totalSales" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="vatableSalesSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{vatableSales}]]></variableExpression>
    </variable>
    <variable name="vatAmountSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{vatAmount}]]></variableExpression>
    </variable>
    <variable name="vatExemptSalesSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{vatExemptSales}]]></variableExpression>
    </variable>
    <variable name="zeroRatedSalesSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{zeroRatedSales}]]></variableExpression>
    </variable>
    <variable name="totalSalesSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalSales}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="100" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="22" uuid="t1"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="22" width="555" height="16" uuid="t2"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="38" width="555" height="16" uuid="t3"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="58" width="555" height="20" uuid="t4"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[VAT Summary Report (BIR)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="78" width="555" height="16" uuid="t5"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo} + "  |  Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#E0E0E0" uuid="ch0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="120" height="20" uuid="ch1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="95" height="20" uuid="ch2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Vatable Sales]]></text>
            </staticText>
            <staticText>
                <reportElement x="215" y="0" width="85" height="20" uuid="ch3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[VAT (12%)]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="90" height="20" uuid="ch4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[VAT-Exempt]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="0" width="80" height="20" uuid="ch5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Zero-Rated]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="85" height="20" uuid="ch6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="16" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="16" backcolor="#F5F5F5" uuid="d0">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="120" height="16" uuid="d1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="120" y="0" width="95" height="16" uuid="d2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vatableSales}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="215" y="0" width="85" height="16" uuid="d3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vatAmount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="300" y="0" width="90" height="16" uuid="d4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vatExemptSales}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="390" y="0" width="80" height="16" uuid="d5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{zeroRatedSales}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="470" y="0" width="85" height="16" uuid="d6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalSales}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="20" uuid="pf1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="60" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1" uuid="s0"/>
            </line>
            <staticText>
                <reportElement x="0" y="4" width="120" height="16" uuid="s1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[GRAND TOTALS:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="120" y="4" width="95" height="16" uuid="s2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{vatableSalesSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="215" y="4" width="85" height="16" uuid="s3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{vatAmountSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="300" y="4" width="90" height="16" uuid="s4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{vatExemptSalesSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="390" y="4" width="80" height="16" uuid="s5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{zeroRatedSalesSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="470" y="4" width="85" height="16" uuid="s6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalSalesSum}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="30" width="555" height="20" uuid="s7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[This report is for reference only. Please verify with official BIR filings.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
