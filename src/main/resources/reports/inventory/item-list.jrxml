<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="item-list"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="item-list-report">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String"/>
    <parameter name="categoryId" class="java.lang.Long"/>

    <!-- Fields -->
    <field name="itemCode" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="categoryName" class="java.lang.String"/>
    <field name="unit" class="java.lang.String"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="costPrice" class="java.math.BigDecimal"/>
    <field name="taxable" class="java.lang.Boolean"/>
    <field name="active" class="java.lang.Boolean"/>

    <!-- Variables -->
    <variable name="totalItems" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{itemCode}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="80">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Item Catalog Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="60" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="50" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="85" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="135" y="0" width="90" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="225" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="295" y="0" width="40" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ Unit]]></text>
            </staticText>
            <staticText>
                <reportElement x="335" y="0" width="65" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Price ]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="65" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Cost ]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="0" width="45" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Taxable]]></text>
            </staticText>
            <staticText>
                <reportElement x="510" y="0" width="45" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Active]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="15">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="50" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemCode}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="50" y="0" width="85" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="135" y="0" width="90" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="225" y="0" width="70" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{categoryName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="295" y="0" width="40" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unit}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="335" y="0" width="65" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="400" y="0" width="65" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{costPrice}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="465" y="0" width="45" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{taxable} ? "Yes" : "No"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="510" y="0" width="45" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{active} ? "Yes" : "No"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement>
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Items: " + $V{totalItems}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
