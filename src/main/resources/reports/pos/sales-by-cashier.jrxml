<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales-by-cashier"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              columnWidth="555"
              uuid="d4e5f6a7-b8c9-0123-defa-234567890123">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>

    <!-- Fields -->
    <field name="cashierName" class="java.lang.String"/>
    <field name="transactionCount" class="java.lang.Integer"/>
    <field name="totalSales" class="java.math.BigDecimal"/>
    <field name="totalVoided" class="java.math.BigDecimal"/>
    <field name="netSales" class="java.math.BigDecimal"/>
    <field name="avgTransactionValue" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="totalTransactionCount" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{transactionCount}]]></variableExpression>
    </variable>
    <variable name="grandTotalSales" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalSales}]]></variableExpression>
    </variable>
    <variable name="grandTotalVoided" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalVoided}]]></variableExpression>
    </variable>
    <variable name="grandNetSales" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{netSales}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Sales by Cashier]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="85" width="555" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="110" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Cashier]]></text>
            </staticText>
            <staticText>
                <reportElement x="110" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[# Sales]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="0" width="100" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Sales]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="90" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Voided]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="0" width="95" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Net Sales]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="0" width="90" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Avg Sale  ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="110" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $F{cashierName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="110" y="0" width="70" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionCount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="180" y="0" width="100" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalSales}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="280" y="0" width="90" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalVoided}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="370" y="0" width="95" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{netSales}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="465" y="0" width="90" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{avgTransactionValue}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="110" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ TOTALS]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="5" width="70" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalTransactionCount}]]></textFieldExpression>
            </textField>
            <textField pattern="₱ #,##0.00">
                <reportElement x="180" y="5" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{grandTotalSales}]]></textFieldExpression>
            </textField>
            <textField pattern="₱ #,##0.00">
                <reportElement x="280" y="5" width="90" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{grandTotalVoided}]]></textFieldExpression>
            </textField>
            <textField pattern="₱ #,##0.00">
                <reportElement x="370" y="5" width="95" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{grandNetSales}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
