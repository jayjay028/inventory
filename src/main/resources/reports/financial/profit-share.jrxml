<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="profit-share"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="b2c3d4e5-f6a7-8901-bcde-f12345678901">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>
    <parameter name="groupBy" class="java.lang.String">
        <defaultValueExpression><![CDATA["ITEM"]]></defaultValueExpression>
    </parameter>

    <!-- Fields -->
    <field name="name" class="java.lang.String"/>
    <field name="totalRevenue" class="java.math.BigDecimal"/>
    <field name="totalCost" class="java.math.BigDecimal"/>
    <field name="grossProfit" class="java.math.BigDecimal"/>
    <field name="profitShare" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="totalRevenueSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalRevenue}]]></variableExpression>
    </variable>
    <variable name="totalCostSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalCost}]]></variableExpression>
    </variable>
    <variable name="grossProfitSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{grossProfit}]]></variableExpression>
    </variable>
    <variable name="profitShareSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{profitShare}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="100" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="22" uuid="t1"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="22" width="555" height="16" uuid="t2"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="38" width="555" height="16" uuid="t3"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="58" width="555" height="20" uuid="t4"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Profit Share Summary]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="78" width="555" height="16" uuid="t5"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo} + "  |  Grouped By: " + $P{groupBy} + "  |  Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#E0E0E0" uuid="ch0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="155" height="20" uuid="ch1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="155" y="0" width="100" height="20" uuid="ch2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Revenue]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="100" height="20" uuid="ch3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Cost]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="0" width="110" height="20" uuid="ch4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Gross Profit]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="0" width="90" height="20" uuid="ch5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Share %]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="16" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="16" backcolor="#F5F5F5" uuid="d0">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="155" height="16" uuid="d1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="155" y="0" width="100" height="16" uuid="d2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalRevenue}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="255" y="0" width="100" height="16" uuid="d3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalCost}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="355" y="0" width="110" height="16" uuid="d4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{grossProfit}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="465" y="0" width="90" height="16" uuid="d5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{profitShare}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="20" uuid="pf1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="40" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1" uuid="s0"/>
            </line>
            <staticText>
                <reportElement x="0" y="4" width="155" height="16" uuid="s1"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[GRAND TOTAL:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="155" y="4" width="100" height="16" uuid="s2"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalRevenueSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="255" y="4" width="100" height="16" uuid="s3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalCostSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="355" y="4" width="110" height="16" uuid="s4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{grossProfitSum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="465" y="4" width="90" height="16" uuid="s5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{profitShareSum}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
