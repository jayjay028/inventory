<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="hourly-sales"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              columnWidth="555"
              uuid="a7b8c9d0-e1f2-3456-abcd-567890123456">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="date" class="java.lang.String"/>
    <parameter name="peakHour" class="java.lang.String"/>
    <parameter name="peakHourSales" class="java.math.BigDecimal"/>

    <!-- Fields -->
    <field name="hour" class="java.lang.Integer"/>
    <field name="hourLabel" class="java.lang.String"/>
    <field name="transactionCount" class="java.lang.Integer"/>
    <field name="totalSales" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="totalDailyTransactions" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{transactionCount}]]></variableExpression>
    </variable>
    <variable name="totalDailySales" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalSales}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Hourly Sales Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + $P{date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="85" width="555" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Hour]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="175" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ Time Slot]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="130" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[# Transactions]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="170" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Sales  ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="80" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{hour}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="0" width="175" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $F{hourLabel}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0">
                <reportElement x="255" y="0" width="130" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionCount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="385" y="0" width="170" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalSales}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="65">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>

            <!-- Totals -->
            <staticText>
                <reportElement x="0" y="5" width="255" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ TOTAL DAILY SALES]]></text>
            </staticText>
            <textField pattern="#,##0">
                <reportElement x="255" y="5" width="130" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalDailyTransactions}]]></textFieldExpression>
            </textField>
            <textField pattern="₱ #,##0.00">
                <reportElement x="385" y="5" width="170" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalDailySales}]]></textFieldExpression>
            </textField>

            <!-- Peak Hour -->
            <line>
                <reportElement x="0" y="28" width="555" height="1"/>
            </line>
            <rectangle>
                <reportElement x="0" y="33" width="555" height="25" backcolor="#FFF2CC"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="33" width="80" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[⭐ Peak Hour:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="85" y="33" width="200" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{peakHour}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="285" y="33" width="50" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="335" y="33" width="215" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{peakHourSales}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
