<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="shift-report"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              columnWidth="555"
              uuid="b2c3d4e5-f6a7-8901-bcde-f12345678901">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String">
        <defaultValueExpression><![CDATA["₱"]]></defaultValueExpression>
    </parameter>
    <parameter name="shiftId" class="java.lang.Long"/>

    <!-- Fields -->
    <field name="cashier" class="java.lang.String"/>
    <field name="openedAt" class="java.lang.String"/>
    <field name="closedAt" class="java.lang.String"/>
    <field name="openingAmount" class="java.math.BigDecimal"/>
    <field name="totalSales" class="java.math.BigDecimal"/>
    <field name="totalTransactions" class="java.lang.Integer"/>
    <field name="totalVoided" class="java.math.BigDecimal"/>
    <field name="cashSales" class="java.math.BigDecimal"/>
    <field name="gcashSales" class="java.math.BigDecimal"/>
    <field name="bankTransferSales" class="java.math.BigDecimal"/>
    <field name="creditSales" class="java.math.BigDecimal"/>
    <field name="expectedAmount" class="java.math.BigDecimal"/>
    <field name="closingAmount" class="java.math.BigDecimal"/>
    <field name="difference" class="java.math.BigDecimal"/>

    <!-- Title Band -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["TIN: " + $P{businessTin}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Shift Report (X-Reading)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Shift ID: " + $P{shiftId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="85" width="555" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail Band (Receipt-style layout) -->
    <detail>
        <band height="380">
            <!-- Shift Information Section -->
            <rectangle>
                <reportElement x="100" y="0" width="355" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="100" y="0" width="355" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SHIFT INFORMATION]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="25" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Cashier:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="25" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{cashier}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="43" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Shift Opened:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="43" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{openedAt}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="61" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Shift Closed:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="61" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{closedAt}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="79" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Opening Amount:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="79" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{openingAmount}]]></textFieldExpression>
            </textField>

            <!-- Sales Summary Section -->
            <line>
                <reportElement x="100" y="105" width="355" height="1"/>
            </line>
            <rectangle>
                <reportElement x="100" y="110" width="355" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="100" y="110" width="355" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SALES SUMMARY]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="135" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Total Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="135" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{totalSales}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="153" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Total Transactions:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="153" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalTransactions}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="171" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Total Voided:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="171" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalVoided}]]></textFieldExpression>
            </textField>

            <!-- Payment Breakdown Section -->
            <line>
                <reportElement x="100" y="197" width="355" height="1"/>
            </line>
            <rectangle>
                <reportElement x="100" y="202" width="355" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="100" y="202" width="355" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[PAYMENT BREAKDOWN]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="227" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Cash Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="227" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{cashSales}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="245" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[GCash Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="245" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{gcashSales}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="263" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Bank Transfer Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="263" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{bankTransferSales}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="281" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Credit Sales:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="281" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{creditSales}]]></textFieldExpression>
            </textField>

            <!-- Cash Reconciliation Section -->
            <line>
                <reportElement x="100" y="307" width="355" height="1"/>
            </line>
            <rectangle>
                <reportElement x="100" y="312" width="355" height="20" backcolor="#4472C4"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="100" y="312" width="355" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[CASH RECONCILIATION]]></text>
            </staticText>

            <staticText>
                <reportElement x="100" y="337" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Expected Amount:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="337" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{expectedAmount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="355" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Actual (Closing) Amount:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="355" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{closingAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="50">
            <line>
                <reportElement x="300" y="0" width="155" height="1"/>
            </line>
            <staticText>
                <reportElement x="100" y="5" width="150" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Over/Short:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="₱ #,##0.00">
                <reportElement x="250" y="5" width="205" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{difference}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="100" y="30" width="355" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[*** END OF X-READING ***]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
