<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="stock-movement"
              pageWidth="595" pageHeight="842"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="stock-movement-report">

    <!-- Parameters -->
    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessTin" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="currencySymbol" class="java.lang.String"/>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>
    <parameter name="categoryId" class="java.lang.Long"/>

    <!-- Fields -->
    <field name="itemCode" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="totalIn" class="java.math.BigDecimal"/>
    <field name="totalOut" class="java.math.BigDecimal"/>
    <field name="totalAdjust" class="java.math.BigDecimal"/>
    <field name="netMovement" class="java.math.BigDecimal"/>
    <field name="currentStock" class="java.math.BigDecimal"/>

    <!-- Variables -->
    <variable name="totalInSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalIn}]]></variableExpression>
    </variable>
    <variable name="totalOutSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalOut}]]></variableExpression>
    </variable>
    <variable name="totalAdjustSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAdjust}]]></variableExpression>
    </variable>
    <variable name="netMovementSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{netMovement}]]></variableExpression>
    </variable>
    <variable name="currentStockSum" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{currentStock}]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="95">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock Movement Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="60" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="75" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{reportDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#4472C4"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Item Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="0" width="120" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ Item Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="75" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock In ]]></text>
            </staticText>
            <staticText>
                <reportElement x="265" y="0" width="75" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock Out ]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Adjustment ]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="75" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Net Move ]]></text>
            </staticText>
            <staticText>
                <reportElement x="485" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Current ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="15">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="70" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemCode}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="70" y="0" width="120" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="190" y="0" width="75" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalIn}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="265" y="0" width="75" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalOut}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="340" y="0" width="70" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAdjust}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="410" y="0" width="75" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{netMovement}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="485" y="0" width="70" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{currentStock}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="190" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ TOTALS]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="190" y="5" width="75" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalInSum}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="265" y="5" width="75" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalOutSum}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="340" y="5" width="70" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalAdjustSum}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="410" y="5" width="75" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{netMovementSum}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="485" y="5" width="70" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{currentStockSum}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
